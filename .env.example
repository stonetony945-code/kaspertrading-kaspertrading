# Copy this file to .env and fill in your own values. .env is gitignored.
#
# TELEGRAM_BOT_TOKEN
#   From @BotFather on Telegram: /newbot, then it hands you the token.
#   Looks like 1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# TELEGRAM_CHAT_ID
#   Your own chat with the bot. Send the bot any message first, then open
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser and read
#   result[0].message.chat.id — a number, negative for groups.
#
# Verify both with:  node scripts/test-notify.js
# Neither value is ever printed back by the tooling.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
